# MongoDB Atlas Configuration -- TEMPLATE ONLY
#
# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored; this template is committed and PUBLIC, so never put a
# real password here.
#
# Set the same MONGODB_URI and MONGODB_TARGET as Environment Variables in the
# Vercel project settings so the dashboard can read the same collection.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_TARGET=ablation_study.results

# Alternatively, provide the parts separately instead of a full URI:
# MONGODB_USER=<username>
# MONGODB_PASS=<password>
# MONGODB_CLUSTER=<cluster>.mongodb.net
